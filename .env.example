# =============================================================================
# AIDSE Desktop — Environment variables
#
# Copy to .env only if you are running the API by hand. An installed app needs
# none of this: the Tauri shell passes the host, port and token on the command
# line, and the backend puts its SQLite database under AIDSE_DATA_DIR.
#
# Never commit .env.
# =============================================================================

# --- Data location ---
# Where the database, datasets and the encrypted secret file live.
# Defaults to the OS application-data directory.
# AIDSE_DATA_DIR=

# --- Database ---
# Set automatically when the backend runs as the shell's sidecar. Only needed
# if you start the API yourself.
# DATABASE_URL=sqlite+aiosqlite:///./aidse.db

# --- JWT (RS256) ---
# Generate with:
#   openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Security ---
BCRYPT_ROUNDS=12
# Not the encryption key. Provider API keys are encrypted with a per-install
# secret generated on first run and kept in the OS credential store; see
# apps/api/db/vault.py.
SECRET_KEY=change-me-to-a-random-64-char-string-in-production

# --- App ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Behaviour ---
# Run AutoML training in-process. There is no other route.
LOCAL_TRAINING_FALLBACK=true
RATE_LIMIT_ENABLED=true

# --- Frontend ---
# Only for `npm --prefix apps/web run dev` outside the shell. Inside it, the
# frontend asks the shell for the real address.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
