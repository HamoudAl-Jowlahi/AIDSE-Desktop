# =============================================================================
# AIDSE Platform — Environment Variables
# Copy this file to .env and fill in values. Never commit .env to git.
# =============================================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://aidse:aidse_dev_password@localhost:5432/aidse
POSTGRES_USER=aidse
POSTGRES_PASSWORD=aidse_dev_password
POSTGRES_DB=aidse

# --- Redis ---

# --- JWT (RS256) ---
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Then paste PEM content as single-line with \n separators, or use a file path
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Security ---
BCRYPT_ROUNDS=12
SECRET_KEY=change-me-to-a-random-64-char-string-in-production

# --- Object Storage (MinIO for local dev) ---

# --- Celery ---

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
